{
  "name": "una-chat",
  "version": "1.0.0",
  "description": "Laboratorio 5 de Seguridad Informatica - UNA Chat",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "mocha test/test.js",
    "test:unit": "mocha test/test.js",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "jest": "^29.7.0",
    "mocha": "^11.1.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  }
}
